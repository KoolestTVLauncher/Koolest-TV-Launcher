<?xml version="1.0" encoding="utf-8"?>
<!-- Android's default (system roots only), with cleartext allowed as android:usesCleartextTraffic said before. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
