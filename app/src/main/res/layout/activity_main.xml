<?xml version="1.0" encoding="utf-8"?>
<!-- Sized in dp for a 960x540dp TV canvas (1080p and 4K both map to it). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5F7">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Top shelf backdrop: the focused Continue watching card's art, blurred, fading in over the wallpaper. -->
    <ImageView
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- 30nama's static scrims over the stage (start edge and bottom), painted in code from the ground colour. -->
    <View
        android:id="@+id/stageScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- The home screen, laid out like the 30nama TV app: everything in 1080p design px / 2 = dp.
         Menu rail on the start edge (120 px), content from x 184, billboard ending above the focused
         row, whose title always sits at y 640. -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <!-- Top end: weather, clock, then network, Android settings and Plume settings. -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- "14° Cloudy · Paris". Off unless turned on in launcher settings. -->
            <TextView
                android:id="@+id/weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:alpha="0.72"
                android:maxLines="1"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.72"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/wifi"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:contentDescription="Network settings"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/rail_wifi" />

            <ImageView
                android:id="@+id/systemSettings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Settings"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/rail_gear" />

            <ImageView
                android:id="@+id/launcherSettings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Plume settings"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/rail_tune" />
        </LinearLayout>

        <!-- Billboard: eyebrow, title, meta line, plot (3 lines, 820 px wide), ending just above the rows. -->
        <LinearLayout
            android:id="@+id/shelf"
            android:layout_width="430dp"
            android:layout_height="300dp"
            android:layout_marginStart="92dp"
            android:alpha="0"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/shelfEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:textColor="#F0454A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shelfTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="0.92"
                android:maxLines="2"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shelfMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.72"
                android:maxLines="1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/shelfPlot"
                android:layout_width="410dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.72"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.3"
                android:maxLines="3"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Only shown while editing the apps row (it carries the instructions), where the billboard was. -->
        <TextView
            android:id="@+id/appsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="92dp"
            android:layout_marginTop="270dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- The rows (built in code). The stack scrolls so the focused row's title sits at y 320dp (640 px);
             rows above it fade out. Full width: tracks start at x 92dp and earlier cards slide under the menu. -->
        <dev.plume.RowStack
            android:id="@+id/rowStack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="320dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical" />
        </dev.plume.RowStack>

        <!-- Dims the screen while the menu is open. -->
        <View
            android:id="@+id/railDim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0" />

        <!-- Menu rail: icons at rest; focus opens it with labels on a panel and a white pill on the focused item. -->
        <FrameLayout
            android:id="@+id/rail"
            android:layout_width="320dp"
            android:layout_height="match_parent">

            <View
                android:id="@+id/railRest"
                android:layout_width="60dp"
                android:layout_height="match_parent" />

            <View
                android:id="@+id/railPanel"
                android:layout_width="320dp"
                android:layout_height="match_parent"
                android:alpha="0" />

            <LinearLayout
                android:id="@+id/railItems"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="30dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="44dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/plume_mark" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- All apps: hidden until the Apps tile is pressed; Back closes it. -->
    <ScrollView
        android:id="@+id/allApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="28dp"
        android:paddingBottom="28dp"
        android:scrollbars="none"
        android:visibility="gone">

        <!-- Side padding here, not on the ScrollView: there it clipped the first column's focus lift. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="48dp">

            <TextView
                android:id="@+id/allAppsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="All apps"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Sort pills (30nama pills): Home order, A–Z, Most used, Recently used, Recently installed. -->
            <LinearLayout
                android:id="@+id/allAppsSort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal" />

            <GridLayout
                android:id="@+id/allAppsGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:columnCount="5" />
        </LinearLayout>
    </ScrollView>

    <!-- Launcher settings: side panel over a dimmed home screen; Back closes it. -->
    <FrameLayout
        android:id="@+id/settingsScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="380dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="40dp"
            android:paddingEnd="48dp"
            android:paddingBottom="27dp">

            <TextView
                android:id="@+id/settingsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:text="Plume settings"
                android:textSize="20sp" />

            <!-- Scrolls once the rows outgrow the screen; focus moving down scrolls it along. -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/settingsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
