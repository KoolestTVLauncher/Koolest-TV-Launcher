<?xml version="1.0" encoding="utf-8"?>
<!-- Sized in dp for a 960x540dp TV canvas (1080p and 4K both map to it). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5F7">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Top shelf backdrop: the focused Continue watching card's art, blurred, fading in over the wallpaper. -->
    <ImageView
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="27dp"
        android:paddingEnd="48dp"
        android:paddingBottom="32dp">
        <!-- Bottom is a little more than the top: the last text line's box includes space under the letters,
             so this makes the visible gap below Continue Watching match the gap above the clock. -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:textSize="30sp" />

                <TextClock
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:format12Hour="EEE d MMM"
                    android:format24Hour="EEE d MMM"
                    android:textSize="15sp" />

                <!-- "14° Cloudy · Paris". Off unless turned on in launcher settings. -->
                <TextView
                    android:id="@+id/weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.72"
                    android:maxLines="1"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:id="@+id/wifi"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Network settings"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_wifi" />

            <ImageView
                android:id="@+id/allAppsButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:contentDescription="All apps"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_apps" />

            <ImageView
                android:id="@+id/systemSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Settings"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_settings" />

            <ImageView
                android:id="@+id/launcherSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Plume settings"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_tune" />
        </LinearLayout>

        <!-- Top shelf (tvOS style): what the focused item is. Fixed height so the rows below never jump. -->
        <LinearLayout
            android:id="@+id/shelf"
            android:layout_width="560dp"
            android:layout_height="108dp"
            android:alpha="0"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/shelfEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#F0454A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shelfTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shelfMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.72"
                android:maxLines="1"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Only shown while editing the apps row (it carries the instructions). -->
        <TextView
            android:id="@+id/appsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textStyle="bold"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- The rows (built in code). The stack scrolls so the focused row sits at the top of this area;
             rows above it fade out, so nothing needs clipping and focus lifts are never cut. -->
        <dev.plume.RowStack
            android:id="@+id/rowStack"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical" />
        </dev.plume.RowStack>
    </LinearLayout>

    <!-- All apps: hidden until the Apps tile is pressed; Back closes it. -->
    <ScrollView
        android:id="@+id/allApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="28dp"
        android:paddingBottom="28dp"
        android:scrollbars="none"
        android:visibility="gone">

        <!-- Side padding here, not on the ScrollView: there it clipped the first column's focus lift. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="48dp">

            <TextView
                android:id="@+id/allAppsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="All apps"
                android:textSize="20sp" />

            <GridLayout
                android:id="@+id/allAppsGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:columnCount="5" />
        </LinearLayout>
    </ScrollView>

    <!-- Launcher settings: side panel over a dimmed home screen; Back closes it. -->
    <FrameLayout
        android:id="@+id/settingsScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="380dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="40dp"
            android:paddingEnd="48dp"
            android:paddingBottom="27dp">

            <TextView
                android:id="@+id/settingsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:text="Plume settings"
                android:textSize="20sp" />

            <!-- Scrolls once the rows outgrow the screen; focus moving down scrolls it along. -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/settingsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
